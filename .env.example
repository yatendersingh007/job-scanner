# Copy this file to `.env` and fill in the keys for connectors you use.
# Any left blank → that connector self-skips. ATS needs no key.

# Aggregator (Connector A) — set the one matching config.yaml `provider`
# JSEARCH_API_KEY = your RapidAPI key (subscribe to JSearch on rapidapi.com)
JSEARCH_API_KEY=
THEIRSTACK_API_KEY=
PREDICTLEADS_API_KEY=
PREDICTLEADS_API_TOKEN=

# TinyFish (Connector C)
TINYFISH_API_KEY=

# Phone/LAN access to the web app — required ONLY if you set
# web_app.allow_lan_access: true in config.yaml. Anyone who wants to open
# the app from your phone (or any other device on your WiFi) will need to
# type this password once.
WEB_APP_PASSWORD=
